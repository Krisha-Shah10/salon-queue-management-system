# ==============================================================
# Salon Queue Management System - Deployment Environment Config
# ==============================================================

# --------------------------------------------------------------
# 1. RENDER (Backend Web Service) Environment Variables
# --------------------------------------------------------------
# Node.js version (must be >= 22.5.0 for native node:sqlite support)
NODE_VERSION=22.12.0
NODE_ENV=production

# Server network binding (Render sets PORT dynamically; HOST must be 0.0.0.0)
PORT=10000
HOST=0.0.0.0

# CORS Origins (Comma-separated list of allowed frontend URLs, or * for all)
# Example: https://salon-queue-mscit.vercel.app,http://localhost:3000
CORS_ORIGIN=*

# SQLite Persistence Directory (optional, defaults to server/data)
# If using a Render Persistent Disk (e.g. mounted at /var/data):
# DATA_DIR=/var/data
# DATABASE_PATH=/var/data/salon.db


# --------------------------------------------------------------
# 2. VERCEL (Frontend SPA) Environment Variables
# --------------------------------------------------------------
# Public URL of your deployed Render backend (no trailing slash)
# Leave blank during local development to use Vite's built-in proxy.
# Example: https://salon-queue-backend.onrender.com
VITE_API_URL=
